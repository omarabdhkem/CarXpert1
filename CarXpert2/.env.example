# CarXpert Environment Variables
# Copy this file to .env and configure your settings

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=carxpert
POSTGRES_PASSWORD=carxpert123
POSTGRES_DB=carxpert

# MongoDB Configuration
MONGO_USER=carxpert
MONGO_PASSWORD=carxpert123
MONGO_DB=carxpert_analytics

# Database URLs (automatically constructed in docker-compose)
# For local development without Docker:
# DATABASE_URL=postgresql://carxpert:carxpert123@localhost:5432/carxpert
# MONGODB_URI=mongodb://carxpert:carxpert123@localhost:27017/carxpert_analytics?authSource=admin

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=production
PORT=5000

# Session secret (CHANGE THIS IN PRODUCTION!)
SESSION_SECRET=your-super-secret-session-key-change-me-in-production

# ===========================================
# Email Configuration (Optional)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=CarXpert <noreply@carxpert.com>

# ===========================================
# File Upload Configuration
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ===========================================
# Security Configuration
# ===========================================
# CORS_ORIGIN=https://your-domain.com
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
